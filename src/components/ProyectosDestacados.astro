---
const proyectos = [
  {
    titulo: "Puente Atlántico",
    ubicacion: "Panamá",
    descripcion: "Puente atirantado de 1.2 km sobre el Canal de Panamá, reduciendo el tiempo de cruce en 40%.",
    categoria: "Infraestructura",
    año: "2023",
    impacto: "+2M beneficiados"
  },
  {
    titulo: "Planta Solar La Joya",
    ubicacion: "Chile",
    descripcion: "200 MW de capacidad, abasteciendo a 150,000 hogares con energía renovable.",
    categoria: "Energía",
    año: "2024",
    impacto: "-45% emisiones CO2"
  },
  {
    titulo: "Metro Línea 7",
    ubicacion: "Colombia",
    descripcion: "Diseño de 12 estaciones y 18 km de túnel, conectando 5 municipios.",
    categoria: "Transporte",
    año: "2022",
    impacto: "500k viajes/día"
  }
];
---

<section class="py-24 bg-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-aecom-lightblue font-semibold text-sm uppercase tracking-wider">Casos de Éxito</span>
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mt-4 mb-6">
        Proyectos que Transforman Comunidades
      </h2>
      <p class="text-xl text-gray-600">
        Obras que demuestran nuestra excelencia en ingeniería y compromiso con el desarrollo sostenible.
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {proyectos.map((proyecto, index) => (
        <div class="group relative overflow-hidden rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-500">
          <div class="h-80 bg-gradient-to-br from-aecom-blue to-aecom-lightblue flex items-center justify-center relative overflow-hidden">
            <div class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-all duration-300"></div>
            <span class="text-8xl relative z-10 group-hover:scale-110 transition-transform duration-500">
              {proyecto.categoria === "Infraestructura" && "🌉"}
              {proyecto.categoria === "Energía" && "☀️"}
              {proyecto.categoria === "Transporte" && "🚇"}
            </span>
          </div>
          
          <div class="absolute inset-0 bg-gradient-to-t from-aecom-blue via-aecom-blue/80 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500 flex items-end">
            <div class="text-white p-6 transform translate-y-full group-hover:translate-y-0 transition-transform duration-500">
              <p class="text-sm font-semibold mb-2">{proyecto.año}</p>
              <p class="text-lg leading-relaxed">{proyecto.descripcion}</p>
              <p class="text-sm mt-3 font-semibold">Impacto: {proyecto.impacto}</p>
            </div>
          </div>
          
          <div class="p-6 bg-white">
            <span class="text-xs text-aecom-lightblue font-semibold uppercase tracking-wider">{proyecto.categoria}</span>
            <h3 class="text-xl font-bold mt-2 mb-1">{proyecto.titulo}</h3>
            <p class="text-gray-600 text-sm">{proyecto.ubicacion}</p>
          </div>
        </div>
      ))}
    </div>
    
    <div class="text-center mt-12">
      <a href={`${import.meta.env.BASE_URL}proyectos`} class="inline-flex items-center border-2 border-aecom-lightblue text-aecom-lightblue hover:bg-aecom-lightblue hover:text-white px-8 py-3 rounded-md font-semibold transition-all duration-300">
        Ver todos los proyectos
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>