<section class="pt-32 pb-20 bg-white-50">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900">¿Tienes un proyecto en mente?</h2>
      <p class="text-xl text-gray-600 mt-4">
        Cuéntanos tu idea y te daremos una asesoría técnica personalizada
      </p>
    </div>
    
    <form id="contacto-form" class="bg-white rounded-lg shadow-lg p-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <div>
          <label class="block text-gray-700 font-semibold mb-2" for="nombre">Nombre completo *</label>
          <input type="text" id="nombre" name="nombre" required 
                 class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-blue-500">
        </div>
        <div>
          <label class="block text-gray-700 font-semibold mb-2" for="empresa">Empresa / Organización</label>
          <input type="text" id="empresa" name="empresa" 
                 class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-blue-500">
        </div>
        <div>
          <label class="block text-gray-700 font-semibold mb-2" for="email">Correo electrónico *</label>
          <input type="email" id="email" name="email" required 
                 class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-blue-500">
        </div>
        <div>
          <label class="block text-gray-700 font-semibold mb-2" for="telefono">Teléfono</label>
          <input type="tel" id="telefono" name="telefono" 
                 class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-blue-500">
        </div>
      </div>
      
      <div class="mb-6">
        <label class="block text-gray-700 font-semibold mb-2" for="servicio">Servicio de interés *</label>
        <select id="servicio" name="servicio" required 
                class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-blue-500">
          <option value="">Asesoría y consultoría ambiental</option>
          <option value="civil">Gestión del riesgo de deseastres </option>
          <option value="electrica">Topografía - Geomática</option>
          <option value="ambiental">Elaboración y seguimiento SG-SST</option>
          <option value="gestion">Fotogrametría con drones </option>
          <option value="estructural">Servicio de asesoría urbanistica integral </option>
          
        </select>
      </div>
      
      <div class="mb-6">
        <label class="block text-gray-700 font-semibold mb-2" for="mensaje">Mensaje *</label>
        <textarea id="mensaje" name="mensaje" rows="5" required 
                  class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:border-blue-500"
                  placeholder="Describe tu proyecto, requerimientos técnicos y plazos..."></textarea>
      </div>
      
      <div class="mb-6">
        <label class="flex items-center">
          <input type="checkbox" required class="mr-2">
          <span class="text-sm text-gray-600">Acepto la <a href={`${import.meta.env.BASE_URL}politica`} class="text-blue-600">política de privacidad</a> *</span>
        </label>
      </div>
      
      <button type="submit" 
              class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-md transition">
        Enviar mensaje →
      </button>
      
      <p class="text-xs text-gray-500 text-center mt-4">
        * Campos obligatorios. Te responderemos en menos de 24 horas hábiles.
      </p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById("contacto-form") as HTMLFormElement;
  const numeroWhatsApp = "573106961396"; // +57 310 6961396, sin +, sin espacios

  const nombreServicio: Record<string, string> = {
    civil: "Ingeniería Civil",
    electrica: "Ingeniería Eléctrica",
    ambiental: "Consultoría Ambiental",
    gestion: "Gestión de Proyectos",
    estructural: "Diseño Estructural",
    automatizacion: "Automatización Industrial",
  };

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    const nombre = (form.querySelector("#nombre") as HTMLInputElement).value;
    const empresa = (form.querySelector("#empresa") as HTMLInputElement).value;
    const email = (form.querySelector("#email") as HTMLInputElement).value;
    const telefono = (form.querySelector("#telefono") as HTMLInputElement).value;
    const servicioValue = (form.querySelector("#servicio") as HTMLSelectElement).value;
    const mensaje = (form.querySelector("#mensaje") as HTMLTextAreaElement).value;

    const servicio = nombreServicio[servicioValue] || servicioValue;

    let texto = `Hola, mi nombre es *${nombre}* y quisiera contactarlos.\n\n`;
    if (empresa) texto += `*Empresa:* ${empresa}\n`;
    texto += `*Correo:* ${email}\n`;
    if (telefono) texto += `*Teléfono:* ${telefono}\n`;
    texto += `*Servicio de interés:* ${servicio}\n\n`;
    texto += `*Mensaje:*\n${mensaje}`;

    const url = `https://wa.me/${numeroWhatsApp}?text=${encodeURIComponent(texto)}`;
    window.open(url, "_blank");
  });
</script>