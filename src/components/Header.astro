<header class="fixed top-0 w-full bg-white/95 backdrop-blur-sm shadow-md z-50 transition-all duration-300">
  <nav class="container mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
    <!-- Logo -->
    <div class="text-2xl font-bold">
      <a href={import.meta.env.BASE_URL} class="block hover:opacity-80 transition">
  <img 
    src="https://spar2099.sirv.com/pimat/LOGO%20PIMAT.png" 
    class="w-32 h-auto object-contain"
    alt="Logo PIMAT"
  />
</a>
    </div>
    
    <!-- Menú Desktop -->
    <ul class="hidden md:flex space-x-8 text-gray-700 font-medium">
      <li><a href={import.meta.env.BASE_URL} class="hover:text-aecom-lightorange transition-colors duration-300">Inicio</a></li>
      <li><a href={`${import.meta.env.BASE_URL}servicios`} class="hover:text-aecom-lightorange transition-colors duration-300">Servicios</a></li>
      <li><a href={`${import.meta.env.BASE_URL}proyectos`} class="hover:text-aecom-lightorange transition-colors duration-300">Proyectos</a></li>
      <li><a href={`${import.meta.env.BASE_URL}empresa`} class="hover:text-aecom-lightorange transition-colors duration-300">Quiénes Somos</a></li>
      
    </ul>
    
    <!-- Botón Cotizar -->
    <a href={`${import.meta.env.BASE_URL}contacto`} 
class="hidden md:inline-block bg-aecom-orange text-white px-6 py-2 rounded-md hover:bg-aecom-lightorange transition-colors duration-300 font-semibold">
      Cotizar Proyecto
    </a>
    
    <!-- Menú Móvil -->
    <button class="md:hidden text-gray-700">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>
  <div id="mobileMenu" class="hidden md:hidden bg-white px-6 pb-4">
  <ul class="flex flex-col space-y-4 text-gray-700 font-medium">
    <li><a href={import.meta.env.BASE_URL}>Inicio</a></li>
    <li><a href={`${import.meta.env.BASE_URL}servicios`}>Servicios</a></li>
    <li><a href={`${import.meta.env.BASE_URL}proyectos`}>Proyectos</a></li>
    <li><a href={`${import.meta.env.BASE_URL}empresa`}>Quiénes Somos</a></li>
    <li>
      <a href={`${import.meta.env.BASE_URL}contacto`} class="block bg-aecom-orange text-white px-4 py-2 rounded-md text-center">
        Cotizar Proyecto
      </a>
    </li>
  </ul>
</div>
<script>
document.addEventListener("DOMContentLoaded", () => {
  const btn = document.querySelector("button.md\\:hidden");
  const menu = document.getElementById("mobileMenu");

  btn.addEventListener("click", () => {
    menu.classList.toggle("hidden");
  });
});
</script>
</header>