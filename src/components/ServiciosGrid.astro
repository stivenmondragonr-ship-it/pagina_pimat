<section class="py-20 bg-gray/90">
  <div class="container mx-auto px-4 md:px-6">

    <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">
      Servicios de Ingeniería Especializada
    </h2>

    <div class="relative overflow-hidden max-w-6xl mx-auto">

      <!-- TRACK -->
      <div id="servicios-track" class="flex transition-transform duration-500">

        {servicios.map((servicio) => (
          <div class="w-full flex-shrink-0 px-3">

            <div class="bg-white rounded-xl shadow-lg overflow-hidden servicio-card">

              <!-- HEADER -->
              <div class="cursor-pointer servicio-header">

                <!-- IMAGEN A PANTALLA COMPLETA DE LA TARJETA -->
                <div class="w-full h-64 sm:h-80 lg:h-96 relative bg-white">
                  <img 
                    src={servicio.icono}
                    class="w-full h-full object-contain transition-transform duration-300 hover:scale-105"
                  />
                </div>

                <div class="p-4 text-center">
                  <h3 class="text-base md:text-lg font-bold">
                    {servicio.titulo}
                  </h3>
                </div>

              </div>

              <!-- CONTENIDO -->
              <div class="contenido max-h-0 overflow-hidden transition-all duration-500 px-5">
                <ul class="list-disc pl-5 text-sm text-gray-600 space-y-1 pb-4">
                  {servicio.descripcion.map(item => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>

            </div>

          </div>
        ))}

      </div>

      <!-- BOTONES -->
      <button id="prevServicios" class="absolute left-2 top-1/2 -translate-y-1/2 bg-white px-3 py-2 shadow rounded-full z-10">‹</button>
      <button id="nextServicios" class="absolute right-2 top-1/2 -translate-y-1/2 bg-white px-3 py-2 shadow rounded-full z-10">›</button>

    </div>

  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", () => {

  const track = document.getElementById("servicios-track");
  const originalItems = Array.from(track.children);

  let visible = getVisibleItems();
  let index = visible;

  function getVisibleItems() {
    // Siempre 1 tarjeta visible, en cualquier tamaño de pantalla
    return 1;
  }

  function setupClones() {
    track.innerHTML = "";
    originalItems.forEach(el => track.appendChild(el));

    visible = getVisibleItems();

    const clonesBefore = originalItems.slice(-visible).map(el => el.cloneNode(true));
    const clonesAfter = originalItems.slice(0, visible).map(el => el.cloneNode(true));

    clonesBefore.forEach(clone => track.prepend(clone));
    clonesAfter.forEach(clone => track.appendChild(clone));

    index = visible;
    updateCarousel(false);
  }

  function updateCarousel(animate = true) {
    const percentage = 100 / visible;
    track.style.transition = animate ? "transform 0.5s" : "none";
    track.style.transform = `translateX(-${index * percentage}%)`;
  }

  function nextSlide() {
    index++;
    updateCarousel();

    if (index >= track.children.length - visible) {
      setTimeout(() => {
        index = visible;
        updateCarousel(false);
      }, 500);
    }
  }

  function prevSlide() {
    index--;
    updateCarousel();

    if (index <= 0) {
      setTimeout(() => {
        index = track.children.length - (visible * 2);
        updateCarousel(false);
      }, 500);
    }
  }

  document.getElementById("nextServicios").onclick = nextSlide;
  document.getElementById("prevServicios").onclick = prevSlide;

  // 🔥 ACORDEÓN (FUNCIONA CON CLONES)
  document.addEventListener("click", (e) => {
    const header = e.target.closest(".servicio-header");
    if (!header) return;

    const card = header.closest(".servicio-card");
    const contenido = card.querySelector(".contenido");

    document.querySelectorAll(".contenido").forEach(el => {
      if (el !== contenido) el.style.maxHeight = "0px";
    });

    if (contenido.style.maxHeight && contenido.style.maxHeight !== "0px") {
      contenido.style.maxHeight = "0px";
    } else {
      contenido.style.maxHeight = contenido.scrollHeight + "px";
    }
  });

  // 🔥 INIT
  setupClones();

  // 🔥 RESPONSIVE FIX
  window.addEventListener("resize", () => {
    setupClones();
  });

});
</script>