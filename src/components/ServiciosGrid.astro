---
const servicios = [
  {
    titulo: "Consultoría ambiental",
    icono: "🌱",
    descripcion: [
      "Estudios de impacto Ambiental.",
      "Planes de ordenamiento y gestión ambiental.",
      "Procesos de planificación territorial en la estructuración de planes de desarrollo Municipal, Departamental y Distrital.",
      "Planes de adaptación a la guía ambiental PAGA.",
      "Planes de Manejo Ambiental PMA.",
      "Planes de Gestión integral de Residuos Sólidos PGIRS.",
      "Diagnóstico Ambiental de Alternativas."
    ],
    foto: "https://spar2099.sirv.com/pimat/Gemini_Generated_Image_v2yuaov2yuaov2yu.png",
    color: "aecom-lightorange"
  },
  {
    titulo: "Gestión del riesgo de desastres",
    icono: "⚠️",
    descripcion: [
      "Estudios de susceptibilidad, amenaza, vulnerabilidad y riesgo de desastres.",
      "Incorporación de la gestión de riesgos en POT u proyectos de inversión público-privado.",
      "Desarrollo de instrumentos de planificación municipal (PMGRD, EMRE y EMREc).",
      "Estudios en conocimiento y reducción del riesgo, evaluación de daños y manejo de emergencias."
    ],
    foto: "https://spar2099.sirv.com/pimat/Gemini_Generated_Image_ooodqhooodqhoood.png",
    color: "aecom-orange"
  },
  {
    titulo: "Topografía y geomática",
    icono: "📐",
    descripcion: [
      "Levantamiento: Planimétrico, altimétrico, replanteo de puntos y ejes.",
      "Georreferenciación.",
      "Verificación de áreas y linderos.",
      "Cartografía temática.",
      "Integración topografía + SIG.",
      "Levantamientos para estudios hidrológicos y ambientales.",
      "Asesoría técnica en normativas y requisitos topográficos."
    ],
    foto: "https://spar2099.sirv.com/pimat/Gemini_Generated_Image_h500gih500gih50.png",
    color: "aecom-blue"
  },
  {
    titulo: "Elaboración y seguimiento SG-SST",
    icono: "🦺",
    descripcion: [
      "Diseño, implementación o mantenimiento del SG-SST.",
      "Auditorías internas del SG-SST.",
      "Elaboración de matrices de peligros con priorización de riesgos.",
      "Diseño e implementación del Programa de Prevención y protección contra caídas.",
      "Elaboración Plan de emergencias, acompañamiento en Simulacros de Emergencias y Capacitación a brigadas de emergencia."
    ],
    foto: "https://spar2099.sirv.com/pimat/Gemini_Generated_Image_6bij4z6bij4z6bij.png",
    color: "aecom-lightblue"
  },
  {
    titulo: "Fotogrametría con drones",
    icono: "🛩️",
    descripcion: [
      "Fotogrametría para proyectos inmobiliarios, inspecciones visuales o material promocional.",
      "Mapeo 2D con Drones (ortomosaico).",
      "Elaboración de Modelo Digital de Elevaciones DEM.",
      "Modelado 3D simplificado (nubes de puntos o modelos texturizados).",
      "Seguimiento de proyectos a obras de construcción.",
      "Inspecciones de áreas de tejados, torres o zonas de difícil acceso.",
      "Monitoreo de cultivos (Nivel inicial)."
    ],
    foto: "https://spar2099.sirv.com/pimat/Gemini_Generated_Image_z8ic0kz8ic0kz8i.png",
    color: "aecom-orange"
  },
  {
    titulo: "Asesoría urbanística integral",
    icono: "🏙️",
    descripcion: [
      "Trámite y gestión de licencias urbanísticas.",
      "Formulación y estructuración de planes parciales.",
      "Avalúos prediales.",
      "Conceptos de norma urbanística.",
      "Acompañamiento en procesos de desarrollo urbano."
    ],
    foto: "https://spar2099.sirv.com/pimat/Gemini_Generated_Image_op4qo4op4qo4op4q.png",
    color: "aecom-lightorange"
  }
];

// Mapa de clases COMPLETAS y estáticas por color, para que Tailwind
// pueda detectarlas al escanear el archivo (las clases armadas
// dinámicamente con template strings no las detecta).
const colorStyles = {
  "aecom-orange": { badge: "bg-aecom-orange", halo: "bg-aecom-orange/15", dot: "bg-aecom-orange" },
  "aecom-lightorange": { badge: "bg-aecom-lightorange", halo: "bg-aecom-lightorange/15", dot: "bg-aecom-lightorange" },
  "aecom-blue": { badge: "bg-aecom-blue", halo: "bg-aecom-blue/15", dot: "bg-aecom-blue" },
  "aecom-lightblue": { badge: "bg-aecom-lightblue", halo: "bg-aecom-lightblue/15", dot: "bg-aecom-lightblue" },
};
---

<section id="servicios" class="py-20  overflow-hidden">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">

    

    <div class="space-y-16 md:space-y-24">
      {servicios.map((servicio, i) => (
        <div class="grid md:grid-cols-2 gap-8 md:gap-14 items-center">

          <!-- IMAGEN -->
          <div
            class:list={[
              "relative",
              i % 2 === 1 ? "md:order-2" : "md:order-1",
            ]}
          >
            <div class={`absolute -inset-3 md:-inset-5 rounded-[2.5rem] ${colorStyles[servicio.color].halo} -z-10`}></div>
            <img
              src={servicio.foto}
              alt={servicio.titulo}
              class="w-full h-64 sm:h-80 md:h-96 object-cover rounded-3xl shadow-xl"
              loading="lazy"
            />
          </div>

          <!-- TEXTO -->
          <div class:list={[i % 2 === 1 ? "md:order-1" : "md:order-2"]}>
            <div class={`inline-flex items-center gap-3 ${colorStyles[servicio.color].badge} text-white px-5 py-3 rounded-xl font-bold text-lg md:text-xl mb-5 shadow-md`}>
              <span class="text-2xl leading-none">{servicio.icono}</span>
              <span>{servicio.titulo}</span>
            </div>

            <ul class="space-y-2.5">
              {servicio.descripcion.map((item) => (
                <li class="flex items-start gap-3 text-gray-700 leading-relaxed">
                  <span class={`mt-2 h-1.5 w-1.5 rounded-full ${colorStyles[servicio.color].dot} flex-shrink-0`}></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>