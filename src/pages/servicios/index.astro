---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ServiciosGrid from '../../components/ServiciosGrid.astro';
---

<Layout title="Servicios de Ingeniería">
  <Header />
  <section class="pt-32 pb-20 bg-aecom-orange flex items-center justify-center">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
    
    <h1 class="text-5xl md:text-6xl font-bold mb-4 animate-fade-in">
      Nuestros Servicios
    </h1>

  </div>
</section>
  
  
  <ServiciosGrid />
  
  <!-- Metodología -->
  <section class="py-20 bg-white/100">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">Metodología de Trabajo</h2>
        <p class="text-xl text-gray-600">Un proceso estructurado para garantizar el éxito de tu proyecto</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="text-center group">
          <div class="w-20 h-20 bg-aecom-lightorange text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4 group-hover:scale-110 transition-transform">1</div>
          <h3 class="font-bold text-xl mb-2">Análisis</h3>
          <p class="text-gray-600">Estudio de viabilidad y requisitos técnicos</p>
        </div>
        <div class="text-center group">
          <div class="w-20 h-20 bg-aecom-lightorange text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4 group-hover:scale-110 transition-transform">2</div>
          <h3 class="font-bold text-xl mb-2">Diseño</h3>
          <p class="text-gray-600">Ingeniería de detalle y planos ejecutivos</p>
        </div>
        <div class="text-center group">
          <div class="w-20 h-20 bg-aecom-lightorange text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4 group-hover:scale-110 transition-transform">3</div>
          <h3 class="font-bold text-xl mb-2">Ejecución</h3>
          <p class="text-gray-600">Construcción y supervisión técnica</p>
        </div>
        <div class="text-center group">
          <div class="w-20 h-20 bg-aecom-lightorange text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4 group-hover:scale-110 transition-transform">4</div>
          <h3 class="font-bold text-xl mb-2">Entrega</h3>
          <p class="text-gray-600">Puesta en marcha y seguimiento post-proyecto</p>
        </div>
      </div>
    </div>
  </section>
  
  <Footer />
</Layout>