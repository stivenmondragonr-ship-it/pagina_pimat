---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactoForm from '../components/ContactoForm.astro';
---

<Layout title="Contacto">
  <Header />
  
  
  <section class="pt-32 pb-20 bg-aecom-orange flex items-center justify-center">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
    
    <h1 class="text-5xl md:text-6xl font-bold mb-4 animate-fade-in">
      Contáctanos
    </h1>
    <p class="text-xl max-w-2xl mx-auto">
        Estamos listos para ayudarte con tu próximo proyecto
      </p>

  </div>
</section>
  <ContactoForm />
  
  <!-- Información de contacto adicional -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="text-3xl mb-3">📍</div>
          <h3 class="font-bold mb-2">Oficina Principal</h3>
          <p class="text-gray-600">Cra. 8 # 8-37<br/>Restrepo-Meta</p>
        </div>
        <div class="text-center">
          <div class="text-3xl mb-3">📞</div>
          <h3 class="font-bold mb-2">Teléfono</h3>
          <p class="text-gray-600">+57 310 6961396<br/>Lun-Vie 8-18h</p>
        </div>
        <div class="text-center">
          <div class="text-3xl mb-3">✉️</div>
          <h3 class="font-bold mb-2">Email</h3>
          <p class="text-gray-600">pimatsas2025@gmail.com<br/>pimat.admin@gmail.com</p>
        </div>
      </div>
    </div>
  </section>
  
  <div class="relative w-full h-[400px] md:h-[500px] rounded-xl overflow-hidden shadow-lg">

  <!-- MAPA -->
  <iframe
    src="https://www.google.com/maps/embed?pb=..."
    class="w-full h-full"
    loading="lazy"
  ></iframe>

  <!-- CAPA CLICKEABLE -->
  <a 
    href="https://maps.app.goo.gl/vahcWnm3vWSdyAUH9"
    target="_blank"
    class="absolute inset-0 z-10"
  ></a>

</div>
  
  <Footer />
</Layout>