---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';


const proyectos = [
  {
    slug: "puente-atlantico",
    titulo: "Inspección de cubiertas y terrazas",
    imagen: "https://spar2099.sirv.com/pimat/tejado%20(2).jpeg",
  },
  {
    slug: "planta-solar",
    titulo: "Levantamientos topográficos",
    imagen: "https://spar2099.sirv.com/pimat/topografia%20(3).jpeg",
  },
  {
    slug: "metro-linea-7",
    titulo: "Modelación 3D",
    imagen: "https://spar2099.sirv.com/pimat/Captura%20de%20pantalla%202026-08-05%20200624.png",
  }
];
---

<Layout title="Proyectos">
  <Header />

<section class="pt-32 pb-20 bg-aecom-orange flex items-center justify-center">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
    
    <h1 class="text-5xl md:text-6xl font-bold mb-4 animate-fade-in">
      Nuestros Proyectos
    </h1>

  </div>
</section>


  <section class="pt-32 pb-20 bg-white-50">
    <div class="container mx-auto px-6">
      

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {proyectos.map((proyecto) => (
          <a href={`/proyectos/${proyecto.slug}`} 
             class="group block overflow-hidden rounded-xl shadow-lg">

            <div class="h-64 overflow-hidden">
              <img 
                src={proyecto.imagen}
                class="w-full h-full object-cover group-hover:scale-110 transition duration-500"
              />
            </div>

            <div class="p-4 bg-white">
              <h3 class="text-xl font-bold">{proyecto.titulo}</h3>
            </div>

          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>